apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: profertility
type: Opaque
stringData:
  PORT: "7005"
  REDIRECT_URL: "https://api.example.com"
  FRONTEND_URL: "https://example.com"
  NEXT_PUBLIC_ADMIN_DASHBOARD_URL: "https://admin.example.com"
  ADMIN_DASHBOARD_URL: "https://admin.example.com"
  PROFERTILITYPLUS: "https://plus.example.com"
  DB_NAME: "Profertility"
  DATABASE_URL: "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=profertility-eks"
  JWT_SECRET_KEY: "replace-with-your-jwt-secret-key"
  SMTP_HOST: "smtp.example.com"
  SMTP_PORT: "465"
  SMTP_USER: "business@example.com"
  SMTP_PASS: "replace-with-smtp-password"
  SMTP_SECURE: "true"
  ENQUIRIES_SMTP_HOST: "smtp.example.com"
  ENQUIRIES_SMTP_PORT: "465"
  ENQUIRIES_SMTP_USER: "help@example.com"
  ENQUIRIES_SMTP_PASS: "replace-with-enquiries-smtp-password"
  ENQUIRIES_SMTP_SECURE: "true"
  TIMEZONE: "UTC"
  STRIPE_SECRET_KEY: "sk_test_replace_with_stripe_secret_key"
  STRIPE_PUBLISHABLE_KEY: "pk_test_replace_with_stripe_publishable_key"
  STRIPE_WEBHOOK_SECRET: "whsec_replace_with_stripe_webhook_secret"
  STRIPE_PRICE_MONTHLY: "price_replace_with_monthly_price_id"
  STRIPE_PRICE_SIX_MONTH: "price_replace_with_six_month_price_id"
